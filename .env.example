# Market data: yahoo (free, no key) | demo (synthetic, offline)
WATCHSTREET_MARKET_PROVIDER=yahoo

# Agent runner: offline (rule-based, no LLM) | llama (local llama.cpp container) | openai | anthropic | cli
WATCHSTREET_AGENT_RUNNER=offline

# anthropic
ANTHROPIC_API_KEY=
WATCHSTREET_ANTHROPIC_MODEL=claude-sonnet-5-5

# openai-compatible (e.g. Ollama on the host)
WATCHSTREET_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
WATCHSTREET_OPENAI_MODEL=llama3.1
WATCHSTREET_OPENAI_API_KEY=

# cli: command that reads the prompt on stdin and prints the answer on stdout
WATCHSTREET_AGENT_CLI_COMMAND=claude -p

# How often the worker scans for new events (minutes). Hourly by default.
WATCHSTREET_EVENT_SCAN_INTERVAL_MIN=60

# Tool calling (agent records insights/thesis/follow-ups via tools). Falls back to JSON if unsupported.
WATCHSTREET_AGENT_TOOLS=true

# --- Database (docker compose) ---
POSTGRES_PASSWORD=watchstreet
# DATA_DIR=./data            # where Postgres keeps its files (inside the project by default)

# --- Local LLM via llama.cpp (docker compose --profile llm-gpu | llm-cpu) ---
# MODELS_DIR=./models
LLAMA_MODEL=model.gguf         # file name inside ./models
LLAMA_CTX=8192
LLAMA_N_GPU_LAYERS=99          # 0 = CPU only; lower it to keep VRAM for other things
LLAMA_THREADS=8
LLAMA_PARALLEL=1
# LLAMA_GPU_COUNT=all          # or 1, 2 ... to limit GPUs
# LLAMA_MEM_LIMIT=24g          # RAM cap for the container

# SEC EDGAR requires a contact in the User-Agent (name and e-mail)
WATCHSTREET_SEC_USER_AGENT=Your Name your.email@example.com

# --- access (required as soon as the app is reachable from outside this machine) ---
# Login password; empty = no login. Never deploy publicly without it.
WATCHSTREET_PASSWORD=
# Signs session cookies; set a long random value so logins survive restarts
# (e.g. `openssl rand -hex 32`).
WATCHSTREET_SECRET_KEY=
# Public deployment only (docker-compose.public.yml): the domain Caddy gets a certificate for.
WATCHSTREET_DOMAIN=
